###############################################################################
# ikea_energy.py — configuration template
#
# Copy to .env and fill in. .env is gitignored; this file is committed.
#
#   cp .env.example .env          # macOS / Linux / WSL
#   Copy-Item .env.example .env   # PowerShell
#
# Values here are DEFAULTS/EXAMPLES, not secrets. Never put a real PSK,
# app password or AWS secret key in this file.
###############################################################################

# =============================================================================
# TRADFRI GATEWAY
# =============================================================================

# LAN IP or hostname of the gateway. Find it in your router's DHCP client list
# (device name looks like "GW-XXXXXXXXXXXX") or with `arp -a`.
TRADFRI_HOST=192.168.1.50

# Identity this script registers with the gateway. Any string; keep it stable,
# because the PSK below is bound to it.
TRADFRI_IDENTITY=ikea_energy

# Pre-shared key. Produced ONCE by `python ikea_energy.py --pair`, then pasted
# here. Leave empty until you have run pairing.
TRADFRI_PSK=

# The 16-character security code printed on the sticker on the BOTTOM of the
# gateway. Needed ONLY for `--pair`. Once TRADFRI_PSK is filled in you can blank
# this out again.
TRADFRI_SECURITY_CODE=

# CoAP/DTLS transport: auto | aiocoap | libcoap
#   auto    - use aiocoap if importable, else the coap-client binary
#   aiocoap - pure-pip transport (aiocoap + DTLSSocket); what requirements.txt installs
#   libcoap - shell out to a `coap-client` binary built with DTLS support
TRADFRI_TRANSPORT=auto

# Per-request timeout, seconds. The gateway is slow; don't go below 5.
TRADFRI_TIMEOUT=10

# =============================================================================
# REPORT THRESHOLDS
# =============================================================================

# Battery percentage at/below which a device is CRITICAL (red in the report).
BATTERY_CRITICAL_PCT=20

# Battery percentage at/below which a device is LOW (amber). Must be > critical.
BATTERY_WARNING_PCT=40

# Hours since last contact before a device counts as stale (amber). Three times
# this value, or an unreachable flag from the gateway, counts as critical.
STALE_HOURS=24

# =============================================================================
# E-MAIL DELIVERY
# =============================================================================

# Which backend --email uses: smtp | ses | none
#   smtp - any SMTP server, including Gmail (see GMAIL block below)
#   ses  - AWS Simple Email Service via boto3
#   none - refuse to send; useful to force --json / --html-out only
EMAIL_BACKEND=smtp

# Envelope sender. For Gmail this must be the account in SMTP_USERNAME (or an
# alias it is allowed to send as). For SES it must be a verified identity.
EMAIL_FROM=ikea-reports@example.com

# Optional display name shown to recipients.
EMAIL_FROM_NAME=IKEA Energy

# Recipients, comma-separated.
EMAIL_TO=james@example.com

# Optional, comma-separated.
EMAIL_CC=
EMAIL_REPLY_TO=

# Prepended to the generated subject line.
EMAIL_SUBJECT_PREFIX=[IKEA Energy]

# -----------------------------------------------------------------------------
# SMTP / GMAIL  (used when EMAIL_BACKEND=smtp)
# -----------------------------------------------------------------------------
# Gmail requires an APP PASSWORD, not your normal Google password, and the
# account must have 2-Step Verification enabled:
#   https://myaccount.google.com/apppasswords
# Paste the 16 characters with or without spaces; spaces are stripped.
#
# Google Workspace with SSO: app passwords may be disabled by policy. Use AWS
# SES, or a Workspace SMTP relay, instead.

SMTP_HOST=smtp.gmail.com

# 587 with STARTTLS (recommended) or 465 with implicit TLS.
SMTP_PORT=587

# true  -> connect plain, then upgrade with STARTTLS  (use with port 587)
# false -> connect with implicit TLS from byte one    (use with port 465)
SMTP_STARTTLS=true

SMTP_USERNAME=ikea-reports@example.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Seconds.
SMTP_TIMEOUT=30

# -----------------------------------------------------------------------------
# AWS SES  (used when EMAIL_BACKEND=ses)
# -----------------------------------------------------------------------------
# Region your SES identity is verified in. SES is region-scoped: an address
# verified in us-east-1 cannot send from eu-west-1.
AWS_REGION=us-east-1

# Leave BOTH blank to use the ambient credential chain — an EC2/ECS/Lambda
# instance role, `aws configure` profile, or AWS_PROFILE. That is the preferred
# production setup: no long-lived keys on disk.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: use a named profile from ~/.aws/credentials instead.
AWS_PROFILE=

# Optional SES configuration set, for open/click/bounce event publishing.
SES_CONFIGURATION_SET=

# =============================================================================
# OUTPUT
# =============================================================================

# Where --html-out and --email write chart PNGs and the HTML report.
REPORT_OUTPUT_DIR=out

# Label shown in the report header, so you can tell environments apart.
REPORT_SITE_NAME=Home

# Timezone for timestamps in the report header and subject line. Matters in
# containers, which default to UTC: without this an 08:00 report is stamped
# 06:00. Use a tz database name, e.g. Europe/Stockholm, America/New_York.
# Ignored when running directly on a host that already has a local timezone.
TZ=
