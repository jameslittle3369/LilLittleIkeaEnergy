---
# Secrets referenced by vars.yml / templates/env.j2. Placeholder values only --
# this .example file is committed; the real one is not.
#
# One-time setup:
#   cd deploy/ansible/group_vars/raspberrypi
#   cp vault.yml.example vault.yml
#   # edit vault.yml with real values, THEN encrypt it in place:
#   ansible-vault encrypt vault.yml
#
# To edit later without ever writing plaintext to disk:
#   ansible-vault edit vault.yml
#
# To view without editing:
#   ansible-vault view vault.yml
#
# ansible-playbook will prompt for the vault password automatically
# (--ask-vault-pass), or read it from a file with --vault-password-file.
# Either way, vault.yml itself is gitignored as a plaintext safeguard even
# though the whole point of vault-encrypting it is that it WOULD be safe to
# commit encrypted -- belt and suspenders against a forgotten `encrypt` step.

vault_tradfri_psk: ""                  # from: docker compose run --rm ikea-energy --pair
vault_tradfri_security_code: ""        # sticker under the gateway; blank this out once vault_tradfri_psk is set
vault_smtp_password: ""                # Gmail App Password, https://myaccount.google.com/apppasswords
vault_aws_access_key_id: ""            # leave blank to use the ambient AWS credential chain instead
vault_aws_secret_access_key: ""
