EMAIL_SUBJECT_PREFIX={{ email_subject_prefix }}

SMTP_HOST={{ smtp_host }}
SMTP_PORT={{ smtp_port }}
SMTP_STARTTLS={{ smtp_starttls | lower }}
SMTP_USERNAME={{ smtp_username }}
