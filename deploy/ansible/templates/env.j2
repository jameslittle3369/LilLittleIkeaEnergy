{# Rendered to {{ ikea_energy_app_dir }}/.env, mode 0600, root-owned. #}
{# Never hand-edited on the Pi -- change vars.yml/vault.yml and re-run the playbook. #}

TRADFRI_HOST={{ tradfri_host }}
TRADFRI_IDENTITY={{ tradfri_identity }}
TRADFRI_PSK={{ vault_tradfri_psk }}
TRADFRI_SECURITY_CODE={{ vault_tradfri_security_code }}
TRADFRI_TRANSPORT={{ tradfri_transport }}
TRADFRI_TIMEOUT={{ tradfri_timeout }}

BATTERY_CRITICAL_PCT={{ battery_critical_pct }}
BATTERY_WARNING_PCT={{ battery_warning_pct }}
STALE_HOURS={{ stale_hours }}

EMAIL_BACKEND={{ email_backend }}
EMAIL_FROM={{ email_from }}
EMAIL_FROM_NAME={{ email_from_name }}
EMAIL_TO={{ email_to }}
EMAIL_CC={{ email_cc }}
